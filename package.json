{
  "name": "nexus-launcher",
  "productName": "Nexus",
  "version": "1.2.2",
  "author": {
    "name": "remukanava",
    "email": "remmukannava@gmail.com"
  },
  "description": "All-in-one launcher for apps, games and websites",
  "repository": "github:remukanava123/Nexus",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/check-version.js",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage rpm tar.gz --publish never"
  },
  "build": {
    "appId": "local.nexus.launcher",
    "productName": "Nexus",
    "icon": "assets/icon.png",
    "compression": "store",
    "files": [
      "main.js",
      "shared/**",
      "src/**",
      "renderer/**",
      "assets/**"
    ],
    "asarUnpack": [
      "src/store-apps.ps1",
      "src/extract-icons.ps1",
      "src/launch-wuwa.ps1"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus"
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "tar.gz"
      ],
      "category": "Game",
      "icon": "assets/icon.png",
      "executableName": "nexus",
      "synopsis": "Game and app launcher",
      "description": "All-in-one launcher for games, apps and websites",
      "desktop": {
        "entry": {
          "Name": "Nexus",
          "Comment": "Game and app launcher",
          "Categories": "Game;Utility;",
          "StartupWMClass": "Nexus"
        }
      }
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
